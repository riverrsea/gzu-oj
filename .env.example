# 控制端公开域名；本地 HTTP 调试可填 http://localhost。
GZU_OJ_SITE_ADDRESS=http://localhost
# API 用于浏览器页面与邮件链接的公开根地址；未设置时控制端 Compose 使用 GZU_OJ_SITE_ADDRESS。
# GZU_OJ_PUBLIC_BASE_URL=https://oj.example.com
# API 签发给 Worker 的隐藏测试制品根地址；默认同 GZU_OJ_PUBLIC_BASE_URL。
# 宿主机 API + Docker Worker 本机调试可设为 http://host.docker.internal:8080。
GZU_OJ_WORKER_ARTIFACT_BASE_URL=https://oj.example.com
# PostgreSQL 业务库。
GZU_OJ_DB_NAME=gzu_oj
GZU_OJ_DB_USER=gzu_oj
GZU_OJ_DB_PASSWORD=change-this-database-password
# Spring Session Cookie 在正式 HTTPS 部署时必须设置为 true。
GZU_OJ_SECURE_COOKIE=false
# 邮件投递默认关闭；开启前配置下列 SMTP 参数。
GZU_OJ_MAIL_DELIVERY_ENABLED=false
GZU_OJ_MAIL_HOST=mailpit
GZU_OJ_MAIL_PORT=1025
GZU_OJ_MAIL_USERNAME=
GZU_OJ_MAIL_PASSWORD=
# SMTP 认证、TLS 与超时。Mailpit 保持默认 false；QQ SMTP 465 需设为 true、true、false。
GZU_OJ_MAIL_SMTP_AUTH=false
GZU_OJ_MAIL_SSL_ENABLED=false
GZU_OJ_MAIL_STARTTLS_ENABLED=false
GZU_OJ_MAIL_FROM=
GZU_OJ_MAIL_CONNECTION_TIMEOUT_MS=10000
GZU_OJ_MAIL_TIMEOUT_MS=10000
GZU_OJ_MAIL_WRITE_TIMEOUT_MS=10000
# Worker Token 由管理员接口创建后写入，仅在判题主机保存明文。
GZU_OJ_WORKER_TOKEN=replace-with-at-least-40-random-characters-worker-token
# go-judge 使用与 Worker Token 不同的高强度内部 Token。
GZU_OJ_GO_JUDGE_TOKEN=replace-with-at-least-40-random-characters-go-judge-token
# 异地 Worker 使用控制端公网 HTTPS 地址；一体化部署会由 Compose 覆盖。
GZU_OJ_CONTROL_BASE_URL=https://oj.example.com
GZU_OJ_WORKER_SLOTS=4
# 运行/提交的服务端最短间隔（毫秒），用于防止重复 HTTP 请求；默认 1000。
GZU_OJ_SUBMISSION_COOLDOWN_MS=1000
# 独立 Python Agent 的内部地址和双向 Bearer Token。Token 必须与 ai-agent/.env 一致。
GZU_OJ_AGENT_BASE_URL=http://127.0.0.1:8090
GZU_OJ_AGENT_INTERNAL_TOKEN=replace-with-at-least-40-random-characters-agent-token
# Compose 控制端使用独立的 Agent 检查点数据库；本地进程也可使用同名数据库。
GZU_OJ_AGENT_DB_NAME=gzu_oj_agent
GZU_OJ_AGENT_DB_USER=gzu_oj_agent
GZU_OJ_AGENT_DB_PASSWORD=change-this-agent-database-password
# 容器中的 Agent 默认访问宿主机 Ollama；生产环境改为可访问的 OpenAI 兼容地址。
GZU_OJ_AGENT_LLM_BASE_URL=http://host.docker.internal:11434/v1
GZU_OJ_AGENT_LLM_API_KEY=ollama
GZU_OJ_AGENT_LLM_MODEL=qwen2.5
GZU_OJ_AGENT_LLM_STRUCTURED_OUTPUT_MODE=json_schema
