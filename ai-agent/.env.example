LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5
# 结构化输出模式：json_schema 约束最强但需要网关支持；DeepSeek 等只支持 json_object；
# prompt_json 不发送 response_format，任何兼容网关都能用。网关拒绝时会自动逐级降级。
LLM_STRUCTURED_OUTPUT_MODE=json_object
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
LLM_MAX_CONCURRENT=1
AGENT_DATABASE_URL=postgresql://riversea@127.0.0.1:5432/gzu_oj_agent
KOTLIN_API_BASE_URL=http://127.0.0.1:8080
AGENT_INTERNAL_TOKEN=change-me
